#!/bin/sh
# Copy a verified BasicPitchPoly.mlpackage into the gitignored models/ dir and pin it.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
src=${1:-"$root/build/BasicPitchPoly.mlpackage"}
if [ ! -d "$src" ]; then
  echo "missing package: $src" >&2
  exit 1
fi
mkdir -p "$root/models"
rm -rf "$root/models/BasicPitchPoly.mlpackage"
cp -R "$src" "$root/models/BasicPitchPoly.mlpackage"
python3 - "$root" << 'PY'
import hashlib, sys
from pathlib import Path
root = Path(sys.argv[1])
pkg = root / "models" / "BasicPitchPoly.mlpackage"
digest = hashlib.sha256()
for p in sorted(pkg.rglob("*")):
    if p.is_file():
        digest.update(p.relative_to(pkg).as_posix().encode())
        digest.update(p.read_bytes())
local_line = f"local BasicPitchPoly.mlpackage sha256:{digest.hexdigest()}\n"
# Preserve the stock pins; only the BasicPitchPoly.mlpackage entry is replaced.
lock = root / "models.lock"
kept = []
for raw in lock.read_text().splitlines():
    s = raw.strip()
    if not s or s.startswith("#"):
        kept.append(raw)
        continue
    parts = s.split()
    name = parts[1] if len(parts) >= 2 else ""
    if parts[0] != "local" and (name == "BasicPitchPoly.mlpackage" or name.startswith("BasicPitchPoly.mlpackage/")):
        continue  # replaced by the local line below
    if parts[0] == "local" and (name == "BasicPitchPoly.mlpackage" or name.startswith("BasicPitchPoly.mlpackage/")):
        continue
    kept.append(raw)
kept.append("# local fine-tune bundle (scripts/bundle-coreml). Weights stay gitignored.")
kept.append(local_line.rstrip("\n"))
lock.write_text("\n".join(kept) + "\n")
print(local_line.strip())
PY
echo "bundled into models/ and pinned in models.lock"
echo "Xcode fetch: scripts/fetch-models"
