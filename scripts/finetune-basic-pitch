#!/usr/bin/env python3
"""Fine-tune Basic Pitch (macOS or Linux), then write a Core ML bundle the iOS app can fetch (macOS).

The upstream trainer (basic_pitch/train.py) always builds a fresh model. This script
loads the ICASSP 2022 weights, fits on paired wav+midi, evaluates against the frozen
checkpoint (and the real phone-mic gate when provided), and exports
BasicPitchPoly.mlpackage only if the prompt's ship rule passes.

The architecture and I/O are unchanged (input [1, 43844, 1] at 22050 Hz; note/onset
[172, 88], contour [172, 264]), so the iOS decoder and the web demo work as-is.

It does not commit weights. It writes:
  build/finetune/<stamp>/{train,val}.tfrecord   serialized pairs
  build/finetune/<stamp>/model.best             fine-tuned SavedModel
  build/finetune/<stamp>/metrics.json           eval tables, tuned thresholds, ship decision
  build/finetune/metrics.json                   copy of the latest run's metrics
  build/BasicPitchPoly.mlpackage                exported Core ML package (on ship, macOS)

Usage:
  scripts/finetune-basic-pitch --smoke
  scripts/finetune-basic-pitch --pairs ~/earsheet-data/train [more dirs...] --val ~/earsheet-data/val \\
      [--test ~/earsheet-data/real-test ...] [--mic-gate ~/earsheet-data/mic] \\
      [--lr 1e-4] [--max-epochs 12] [--augment] [--freeze-bn] [--tune-thresholds]
  scripts/finetune-basic-pitch --eval-only --savedmodel DIR --val DIR --out out.json \\
      [--onset-threshold 0.5 --frame-threshold 0.3]

Training defaults (changed after experiments on synthetic + real audio, see
docs/finetune/EXPERIMENTS.md): class-balanced onset loss (plain BCE collapses the onset
head: peaks fall from ~0.97 to ~0.5), BatchNorm frozen in inference mode, one stage
with linear warmup + cosine decay, fresh random windows every epoch, and early
stopping on held-out note F1 that starts from the stock model's score, so a run that
never beats stock keeps stock.

Pairs are basename.wav + basename.mid. WAVs must be 22050 Hz mono 16-bit PCM
(basic_pitch 0.4.0 asserts AUDIO_N_CHANNELS == 1 at serialization). MIDI is parsed
with pretty_midi. Environment: Python 3.10/3.11 with TF 2.15 / Keras 2, e.g.
  pip install 'basic-pitch[tf]==0.4.0' sox 'setuptools<81'   (+ coremltools on the Mac)
"""
from __future__ import annotations

import argparse
import json
import os
import platform
import random
import shutil
import subprocess
import sys
import time
import wave
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
BUILD = ROOT / "build" / "finetune"
PACKAGE_NAME = "BasicPitchPoly.mlpackage"
SOURCE_TAG = "synthetic_sf2"
EXPECTED_IN = (1, 43844, 1)
EXPECTED_OUT = {"note": 88, "onset": 88, "contour": 264}
ONSET_TOLERANCE = 0.05  # 50 ms, per the prompt
DEFAULT_ONSET_T = 0.5
DEFAULT_FRAME_T = 0.3
DEFAULT_MIN_NOTE_LEN = 11


def log(msg: str) -> None:
    print(msg, flush=True)


# ---------------------------------------------------------------- smoke

def smoke() -> int:
    log(f"machine {platform.platform()} {platform.machine()}")
    log(f"python {sys.version.split()[0]}")
    missing = []
    # sox: imported by basic_pitch.data.tf_example_serialization (the "data" extra).
    for mod in ("tensorflow", "basic_pitch", "mir_eval", "pretty_midi", "sox"):
        try:
            __import__(mod)
            log(f"ok {mod}")
        except Exception as exc:  # noqa: BLE001
            missing.append(mod)
            log(f"missing {mod}: {exc}")
    # coremltools is only needed for the Core ML export, which needs macOS anyway.
    # Training and evaluation run anywhere TensorFlow does (Linux CPU included).
    try:
        __import__("coremltools")
        log("ok coremltools")
    except Exception as exc:  # noqa: BLE001
        log(f"note: coremltools unavailable ({exc}); training/eval OK, Core ML export disabled")
    if not missing:
        try:  # resampy (via basic_pitch.inference) still imports pkg_resources (setuptools<81)
            __import__("basic_pitch.inference")
            log("ok basic_pitch.inference")
        except Exception as exc:  # noqa: BLE001
            missing.append("basic_pitch.inference")
            log(f"missing basic_pitch.inference: {exc} (pip install 'setuptools<81')")
    if missing:
        log("install (Python 3.10/3.11, TF 2.15 / Keras 2): python3 -m venv .venv && "
            "source .venv/bin/activate && pip install 'basic-pitch[tf]==0.4.0' sox 'setuptools<81' coremltools")
        return 1
    from basic_pitch import ICASSP_2022_MODEL_PATH
    log(f"icassp {ICASSP_2022_MODEL_PATH} exists={Path(ICASSP_2022_MODEL_PATH).exists()}")
    return 0


# ------------------------------------------------------- serialization

def read_pairs(pairs_dir: Path):
    """Yield (stem, wav_path, mid_path) for basename.wav + basename.mid pairs."""
    wavs = {p.stem: p for p in pairs_dir.glob("*.wav")}
    mids = {p.stem: p for p in pairs_dir.glob("*.mid")}
    for stem in sorted(set(wavs) & set(mids)):
        yield stem, wavs[stem], mids[stem]


def read_many(dirs) -> list:
    out = []
    for d in dirs or []:
        out.extend(read_pairs(d))
    return out


def wav_seconds(wav_path: Path) -> float:
    try:
        w = wave.open(str(wav_path), "rb")
    except (wave.Error, EOFError) as e:
        raise SystemExit(f"{wav_path}: not a readable WAV ({e})")
    with w:
        if w.getframerate() != 22050 or w.getnchannels() != 1 or w.getsampwidth() != 2:
            raise SystemExit(
                f"{wav_path}: need 22050 Hz mono 16-bit PCM "
                f"(got {w.getframerate()} Hz, {w.getnchannels()} ch, {w.getsampwidth() * 8}-bit)"
            )
        return w.getnframes() / float(w.getframerate())


def midi_notes(mid_path: Path):
    """(start_s, end_s, midi, velocity) from a MIDI file, drums skipped."""
    import pretty_midi

    pm = pretty_midi.PrettyMIDI(str(mid_path))
    out = []
    for inst in pm.instruments:
        if inst.is_drum:
            continue
        for n in inst.notes:
            if n.end <= n.start:
                continue
            out.append((float(n.start), float(n.end), int(n.pitch), int(n.velocity)))
    return out


def serialize_split(stems_and_paths, tfrecord_path: Path) -> list[str]:
    """Serialize pairs with basic_pitch's TFExample contract. Returns stems."""
    import numpy as np
    from basic_pitch.constants import (
        ANNOTATION_HOP,
        FREQ_BINS_CONTOURS,
        N_FREQ_BINS_CONTOURS,
        N_FREQ_BINS_NOTES,
    )
    from basic_pitch.data.tf_example_serialization import _to_transcription_tfex

    contour_bins = np.asarray(FREQ_BINS_CONTOURS, dtype=np.float64)
    stems = []
    with tf_record_writer(tfrecord_path) as writer:
        for stem, wav_path, mid_path in stems_and_paths:
            duration = wav_seconds(wav_path)  # validates format too
            if duration < 2.1:
                log(f"  skip {stem}: shorter than one model window")
                continue
            notes = midi_notes(mid_path)
            if not notes:
                log(f"  skip {stem}: no notes in {mid_path.name}")
                continue
            time_scale = np.arange(0, duration + ANNOTATION_HOP, ANNOTATION_HOP)
            n_frames = len(time_scale)

            note_idx, note_val = [], []
            on_idx, on_val = [], []
            con_idx, con_val = [], []
            for start, end, pitch, _vel in notes:
                if not 21 <= pitch <= 108 or start >= duration:
                    continue
                f = pitch - 21
                s = int(np.clip(round(start / ANNOTATION_HOP), 0, n_frames - 1))
                e = int(np.clip(round(end / ANNOTATION_HOP), s + 1, n_frames))
                hz = 440.0 * (2.0 ** ((pitch - 69) / 12.0))
                cb = int(np.argmin(np.abs(contour_bins - hz)))
                for t in range(s, e):
                    note_idx.append((t, f))
                    note_val.append(1.0)
                    con_idx.append((t, cb))
                    con_val.append(1.0)
                # Onset target: the single onset frame (mirdata onsets_only convention).
                on_idx.append((s, f))
                on_val.append(1.0)

            ex = _to_transcription_tfex(
                stem, SOURCE_TAG, open(wav_path, "rb").read(),
                note_idx, note_val, on_idx, on_val, con_idx, con_val,
                (n_frames, N_FREQ_BINS_NOTES), (n_frames, N_FREQ_BINS_CONTOURS),
            )
            writer.write(ex.SerializeToString())
            stems.append(stem)
    log(f"  wrote {tfrecord_path} ({len(stems)} pairs)")
    return stems


def tf_record_writer(path: Path):
    import tensorflow as tf

    path.parent.mkdir(parents=True, exist_ok=True)
    return tf.io.TFRecordWriter(str(path))


# --------------------------------------------------------- augmentation

def make_augmenter(seed: int | None = None):
    """Waveform augmentation for one AUDIO_N_SAMPLES window (tf ops, runs in tf.data):
    random gain, random EQ (tilt + one bell), synthetic room reverb, coloured noise.
    Mirrors what a phone mic in a room does to a clean render. Labels are unchanged."""
    import numpy as np
    import tensorflow as tf
    from basic_pitch.constants import AUDIO_N_SAMPLES, AUDIO_SAMPLE_RATE

    n = AUDIO_N_SAMPLES
    nfft = 1 << int(np.ceil(np.log2(n + 8192)))
    freqs = tf.constant(np.fft.rfftfreq(nfft, 1.0 / AUDIO_SAMPLE_RATE).astype(np.float32))
    logf = tf.math.log(tf.maximum(freqs, 20.0) / 1000.0) / np.log(2.0)  # octaves re 1 kHz
    ir_len = 8192
    t_ir = tf.range(ir_len, dtype=tf.float32) / AUDIO_SAMPLE_RATE
    u = lambda lo, hi: tf.random.uniform((), lo, hi)  # noqa: E731

    def augment(audio, targets):
        x = audio[:, 0]
        # EQ: spectral tilt (+-3 dB/oct) and one bell (+-9 dB, 0.7-3 oct wide), p=0.6
        tilt = tf.where(u(0., 1.) < 0.6, u(-3.0, 3.0), 0.0)
        bell_c, bell_w = u(-2.5, 3.0), u(0.7, 3.0)
        bell_g = tf.where(u(0., 1.) < 0.6, u(-9.0, 9.0), 0.0)
        gain_db = tilt * logf + bell_g * tf.exp(-0.5 * tf.square((logf - bell_c) / (bell_w / 2.355)))
        H = tf.complex(tf.pow(10.0, gain_db / 20.0), 0.0)
        X = tf.signal.rfft(tf.pad(x, [[0, nfft - n]]))
        # Reverb: exponentially decaying noise IR, RT60 0.15-1.0 s, p=0.35
        rt60 = u(0.15, 1.0)
        ir = tf.random.normal([ir_len]) * tf.exp(-6.9 * t_ir / rt60)
        ir = ir / (tf.norm(ir) + 1e-6) * u(0.1, 0.6)
        ir = tf.tensor_scatter_nd_update(ir, [[0]], [1.0])
        Hr = tf.signal.rfft(tf.pad(ir, [[0, nfft - ir_len]]))
        X = X * H
        X = tf.cond(u(0., 1.) < 0.35, lambda: X * Hr, lambda: X)
        y = tf.signal.irfft(X)[:n]
        # Noise: white..pink at 10-40 dB SNR, p=0.5
        rms = tf.sqrt(tf.reduce_mean(tf.square(y)) + 1e-9)
        noise = tf.random.normal([nfft])
        shape = tf.pow(tf.maximum(freqs, 20.0) / 20.0, -u(0.0, 0.5))
        noise = tf.signal.irfft(tf.signal.rfft(noise) * tf.complex(shape, 0.0))[:n]
        noise = noise / (tf.sqrt(tf.reduce_mean(tf.square(noise))) + 1e-9)
        snr = u(10.0, 40.0)
        y = tf.cond(u(0., 1.) < 0.5, lambda: y + noise * rms / tf.pow(10.0, snr / 20.0), lambda: y)
        # Gain: -18..+3 dB, then clip like an ADC
        y = y * tf.pow(10.0, u(-18.0, 3.0) / 20.0)
        y = tf.clip_by_value(y, -1.0, 1.0)
        return tf.ensure_shape(y[:, None], audio.shape), targets

    return augment


# ------------------------------------------------------------- datasets

def make_dataset(tfrecord_path: Path, n_windows_per_track: int, batch: int, training: bool,
                 augment: bool = False):
    import tensorflow as tf
    from basic_pitch.data import tf_example_deserialization as deser

    def file_gen():
        yield str(tfrecord_path)

    # random_seed=True seeds each window draw with its index, i.e. the same windows on
    # every pass. Training wants fresh random windows each epoch; validation wants a
    # fixed set so epoch-to-epoch val loss is comparable.
    ds = deser.transcription_dataset(
        file_gen, n_samples_per_track=n_windows_per_track, random_seed=not training
    )
    # The dataset yields (audio, targets, per-head sample weights). basic_pitch's losses
    # reduce to a scalar, so Keras 2.15 cannot apply per-example weights ("Can not
    # squeeze dim[0]"). Our pairs always label all three heads (weights are all 1),
    # so drop them.
    ds = ds.map(lambda x, y, _w: (x, y))
    if training:
        ds = ds.shuffle(2048)
        if augment:
            ds = ds.map(make_augmenter(), num_parallel_calls=tf.data.AUTOTUNE)
        ds = ds.repeat()
    else:
        ds = ds.cache()
    ds = ds.batch(batch).prefetch(tf.data.AUTOTUNE)
    return ds


# ------------------------------------------------------- weight loading

def load_pretrained(model):
    import tensorflow as tf
    from basic_pitch import ICASSP_2022_MODEL_PATH

    path = Path(ICASSP_2022_MODEL_PATH)
    # pip package ships nmp/ as a SavedModel. Keras checkpoints from a previous run also work.
    if (path / "saved_model.pb").exists() or (path / "keras_metadata.pb").exists():
        loaded = tf.keras.models.load_model(path, compile=False)
        model.set_weights(loaded.get_weights())
        log(f"loaded weights from {path}")
        return model
    raise SystemExit(f"ICASSP weights not a Keras model at {path}; refuse to train from scratch")


def freeze_batchnorm(model) -> int:
    """BatchNorm layers trainable=False => Keras 2 runs them in inference mode with the
    stock moving statistics. Fine-tuning batches of 8 windows otherwise drag the
    statistics toward the new data and hurt everything else."""
    import tensorflow as tf

    n = 0
    for layer in model.layers:
        if isinstance(layer, tf.keras.layers.BatchNormalization):
            layer.trainable = False
            n += 1
    log(f"froze {n} BatchNormalization layers")
    return n


class WarmupCosine:
    """Linear warmup to peak, cosine decay to floor (as a Keras LR schedule)."""

    def __new__(cls, peak: float, warmup: int, total: int, floor_ratio: float = 0.05):
        import math
        import tensorflow as tf

        class _S(tf.keras.optimizers.schedules.LearningRateSchedule):
            def __call__(self, step):
                step = tf.cast(step, tf.float32)
                w = tf.cast(max(1, warmup), tf.float32)
                tot = tf.cast(max(total, warmup + 1), tf.float32)
                warm = peak * step / w
                prog = tf.clip_by_value((step - w) / (tot - w), 0.0, 1.0)
                cos = floor_ratio * peak + (1 - floor_ratio) * peak * 0.5 * (1 + tf.cos(math.pi * prog))
                return tf.where(step < w, warm, cos)

            def get_config(self):
                return {"peak": peak, "warmup": warmup, "total": total}

        return _S()


# ------------------------------------------------------------------ eval

def reference_notes(mid_path: Path):
    """(intervals, pitches) for mir_eval from a MIDI file."""
    import numpy as np

    notes = midi_notes(mid_path)
    intervals = np.array([[s, e] for s, e, _, _ in notes]).reshape(-1, 2)
    pitches = np.array([float(midi_to_hz(p)) for _, _, p, _ in notes])
    return intervals, pitches


def midi_to_hz(midi: int) -> float:
    return 440.0 * (2.0 ** ((midi - 69) / 12.0))


def predict_notes(model_or_path, wav_path: Path, onset_t: float = DEFAULT_ONSET_T,
                  frame_t: float = DEFAULT_FRAME_T):
    """Note events via basic_pitch's own inference + decoder."""
    from basic_pitch import inference

    _out, _midi_data, note_events = inference.predict(
        str(wav_path), model_or_path, onset_threshold=onset_t, frame_threshold=frame_t)
    return note_events  # [(start, end, pitch, amplitude, bends|None)]


def model_outputs(model, pairs) -> dict:
    """Raw model output per clip (so threshold sweeps don't re-run the model)."""
    from basic_pitch import inference

    return {stem: inference.run_inference(str(wav), model) for stem, wav, _ in pairs}


def decode(output, onset_t: float, frame_t: float, min_note_len: int = DEFAULT_MIN_NOTE_LEN):
    from basic_pitch import note_creation as infer

    _midi, events = infer.model_output_to_notes(
        output, onset_thresh=onset_t, frame_thresh=frame_t, infer_onsets=True,
        min_note_len=int(min_note_len), include_pitch_bends=False, melodia_trick=True)
    return events


def note_scores(ref_intervals, ref_pitches, est_events) -> dict:
    """mir_eval note scores: onset-only (50 ms) P/R/F1, plus F1 with offsets (20%/50 ms)."""
    import numpy as np
    import mir_eval

    if not len(est_events):
        return {"p": 0.0, "r": 0.0, "f1": 0.0, "f1_offset": 0.0}
    est_intervals = np.array([[e[0], e[1]] for e in est_events])
    est_pitches = np.array([midi_to_hz(int(e[2])) for e in est_events])
    # precision_recall_f1_overlap returns (precision, recall, f1, avg_overlap_ratio).
    p, r, f, _ = mir_eval.transcription.precision_recall_f1_overlap(
        ref_intervals, ref_pitches, est_intervals, est_pitches,
        onset_tolerance=ONSET_TOLERANCE,
        offset_ratio=None,  # onset-only note F1 per the prompt's 50 ms rule
    )
    _p2, _r2, f_off, _ = mir_eval.transcription.precision_recall_f1_overlap(
        ref_intervals, ref_pitches, est_intervals, est_pitches, onset_tolerance=ONSET_TOLERANCE)
    return {"p": float(p), "r": float(r), "f1": float(f), "f1_offset": float(f_off)}


def note_f1(ref_intervals, ref_pitches, est_events) -> float:
    return note_scores(ref_intervals, ref_pitches, est_events)["f1"]


def score_outputs(outputs: dict, pairs, onset_t: float, frame_t: float,
                  min_note_len: int = DEFAULT_MIN_NOTE_LEN) -> dict:
    f1s, rows = {}, []
    for stem, _wav, mid_path in pairs:
        ref_i, ref_p = reference_notes(mid_path)
        if len(ref_i) == 0 or stem not in outputs:
            continue
        sc = note_scores(ref_i, ref_p, decode(outputs[stem], onset_t, frame_t, min_note_len))
        f1s[stem] = round(sc["f1"], 4)
        rows.append(sc)
    mean = lambda k: round(sum(r[k] for r in rows) / len(rows), 4) if rows else 0.0  # noqa: E731
    return {"mean_f1": mean("f1"), "mean_precision": mean("p"), "mean_recall": mean("r"),
            "mean_f1_with_offset": mean("f1_offset"), "onset_threshold": onset_t,
            "frame_threshold": frame_t, "min_note_len": int(min_note_len),
            "clips": f1s, "n_clips": len(f1s)}


def evaluate_model(model_or_path, pairs, onset_t: float = DEFAULT_ONSET_T,
                   frame_t: float = DEFAULT_FRAME_T, outputs: dict | None = None) -> dict:
    """Per-clip note F1 plus the means, for (stem, wav, mid) pairs."""
    if outputs is None:
        outputs = model_outputs(model_or_path, pairs)
    return score_outputs(outputs, pairs, onset_t, frame_t)


ONSET_GRID = (0.3, 0.4, 0.5, 0.6, 0.7, 0.8)
FRAME_GRID = (0.2, 0.3, 0.4, 0.5)
MIN_NOTE_LEN_GRID = (5, 7, 11)  # frames (11.6 ms each); Spotify's default is 11


def tune_thresholds(outputs: dict, pairs) -> tuple:
    """Grid-search decoder settings (onset, frame, min note length) for mean note F1."""
    best = (DEFAULT_ONSET_T, DEFAULT_FRAME_T, DEFAULT_MIN_NOTE_LEN, -1.0)
    for mnl in MIN_NOTE_LEN_GRID:
        for o in ONSET_GRID:
            for fr in FRAME_GRID:
                f1 = score_outputs(outputs, pairs, o, fr, mnl)["mean_f1"]
                if f1 > best[3]:
                    best = (o, fr, mnl, f1)
    return best


class NoteF1EarlyStopping:
    """Stop when val note-F1 (mir_eval, 50 ms) stops improving. Starts from the stock
    model's val F1, so weights are only kept if they beat stock. Evaluation runs in a
    subprocess so the training session is never disturbed."""

    def __init__(self, keras_model, val_dirs, best_weights_path: Path,
                 eval_json: Path, patience: int, baseline: float = -1.0):
        self.keras_model = keras_model
        self.val_dirs = val_dirs
        self.best_weights_path = best_weights_path
        self.eval_json = eval_json
        self.patience = patience
        self.best = baseline
        self.bad = 0
        self.best_epoch = 0
        self.stopped_epoch = None
        self.history = []

    def on_epoch_end(self, epoch: int, saved_model_dir: Path) -> bool:
        self.keras_model.save(str(saved_model_dir))
        cmd = [sys.executable, str(Path(__file__).resolve()), "--eval-only",
               "--savedmodel", str(saved_model_dir), "--out", str(self.eval_json), "--val"]
        cmd += [str(d) for d in self.val_dirs]
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode != 0:
            log(f"  [val-f1] eval subprocess failed:\n{r.stderr[-2000:]}")
            self.bad += 1
            return self.bad >= self.patience
        table = json.loads(self.eval_json.read_text())
        f1 = table["mean_f1"]
        self.history.append({"epoch": epoch + 1, **{k: v for k, v in table.items() if k != "clips"}})
        log(f"  [val-f1] epoch {epoch + 1}: note F1 {f1:.4f} P {table['mean_precision']:.3f} "
            f"R {table['mean_recall']:.3f} (best {self.best:.4f})")
        if f1 > self.best + 1e-4:
            self.best = f1
            self.bad = 0
            self.best_epoch = epoch + 1
            self.keras_model.save_weights(str(self.best_weights_path))
        else:
            self.bad += 1
        if self.bad >= self.patience:
            self.stopped_epoch = epoch + 1
            return True
        return False


# ---------------------------------------------------------------- export

def export_coreml(keras_model, dest: Path, val_pairs, tf_savedmodel_dir: Path) -> Path:
    """Convert to Core ML, fp16 first; fall back to fp32 if the 5-clip
    TensorFlow-vs-CoreML note comparison fails. Returns the shipped package."""
    import coremltools as ct

    spec_in = getattr(keras_model, "input_shape", None)
    print(f"keras input_shape {spec_in}")
    dest.parent.mkdir(parents=True, exist_ok=True)

    def convert(precision) -> Path:
        out = dest.parent / (dest.stem + (".fp16" if precision == ct.precision.FLOAT16 else ".fp32"))
        if out.exists():
            shutil.rmtree(out)
        ml = ct.convert(
            keras_model,
            convert_to="mlprogram",
            compute_precision=precision,
            minimum_deployment_target=ct.target.iOS17,
        )
        ml.save(str(out))
        return out

    def gate(package: Path) -> bool:
        """Shape gate + 5-clip note comparison against TensorFlow."""
        import numpy as np
        from basic_pitch import inference

        ml = ct.models.MLModel(str(package))
        spec = ml.get_spec()
        in_desc = spec.description.input[0]
        shape = tuple(in_desc.type.multiArrayType.shape)
        outs = {
            o.name: tuple(o.type.multiArrayType.shape) for o in spec.description.output
        }
        print(f"  coreml input {in_desc.name} {shape}; outputs {outs}")
        if tuple(shape) != tuple(EXPECTED_IN):
            print(f"  REFUSE: input shape {shape} != {EXPECTED_IN}")
            return False
        out_shapes = sorted(outs.values())
        want = sorted([(1, 172, 88), (1, 172, 88), (1, 172, 264)])
        if out_shapes != want:
            print(f"  REFUSE: output shapes {out_shapes} != {want}")
            return False

        # 5-clip note comparison: Core ML notes must equal TensorFlow notes.
        tf_model = inference.Model(str(tf_savedmodel_dir))
        cm_model = inference.Model(str(package))
        clips = val_pairs[:5]
        for stem, wav_path, _mid in clips:
            tf_notes = {(round(s, 2), round(e, 2), int(p)) for s, e, p, _, _ in predict_notes(tf_model, wav_path)}
            cm_notes = {(round(s, 2), round(e, 2), int(p)) for s, e, p, _, _ in predict_notes(cm_model, wav_path)}
            if tf_notes != cm_notes:
                print(f"  MISMATCH on {stem}: tf={len(tf_notes)} notes coreml={len(cm_notes)} notes")
                return False
            print(f"  match on {stem} ({len(tf_notes)} notes)")
        return True

    if platform.system() != "Darwin":
        raise SystemExit("Core ML prediction needs macOS; export on the MacBook")

    fp16 = convert(ct.precision.FLOAT16)
    if gate(fp16):
        print("fp16 notes match TensorFlow; shipping fp16")
        chosen = fp16
    else:
        print("fp16 mismatch; trying fp32")
        fp32 = convert(ct.precision.FLOAT32)
        if not gate(fp32):
            raise SystemExit("REFUSE: fp32 Core ML notes differ from TensorFlow; not shipping")
        print("fp32 notes match TensorFlow; shipping fp32")
        chosen = fp32

    if dest.exists():
        shutil.rmtree(dest)
    shutil.move(str(chosen), str(dest))
    for leftover in dest.parent.glob(dest.stem + ".fp*"):
        if leftover != dest and leftover.is_dir():
            shutil.rmtree(leftover)
    spec = ct.models.MLModel(str(dest)).get_spec()
    note = dest.with_suffix(".contract.json")
    note.write_text(json.dumps({
        "package": dest.as_posix(),
        "expected_input": list(EXPECTED_IN),
        "expected_outputs": EXPECTED_OUT,
        "keras_input_shape": str(spec_in),
        "coreml_description": spec.description.metadata.shortDescription if spec.description.HasField("metadata") else "",
    }, indent=2))
    print(f"wrote {dest}")
    print(f"contract note {note}")
    return dest


# ------------------------------------------------------------------ main

def eval_only(args) -> int:
    """Subprocess/CLI entry: note-F1 of a SavedModel dir on --val pairs -> --out JSON."""
    if not args.savedmodel or not args.val or not args.out:
        raise SystemExit("--eval-only needs --savedmodel, --val and --out")
    from basic_pitch import inference

    pairs = read_many(args.val)
    if not pairs:
        raise SystemExit(f"no wav+mid pairs in {args.val}")
    model = inference.Model(str(args.savedmodel))
    outputs = model_outputs(model, pairs)
    table = score_outputs(outputs, pairs, args.onset_threshold, args.frame_threshold, args.min_note_len)
    if args.tune_thresholds:
        o, fr, mnl, _f1 = tune_thresholds(outputs, pairs)
        table["tuned"] = {k: v for k, v in score_outputs(outputs, pairs, o, fr, mnl).items() if k != "clips"}
    args.out.write_text(json.dumps(table, indent=2))
    log(json.dumps({k: v for k, v in table.items() if k != "clips"}))
    return 0


def summarize(t: dict) -> dict:
    return {k: v for k, v in t.items() if k != "clips"} if t else t


def main() -> int:
    parser = argparse.ArgumentParser(description="Fine-tune Basic Pitch and export Core ML")
    parser.add_argument("--smoke", action="store_true")
    parser.add_argument("--pairs", type=Path, nargs="+",
                        help="Training dirs of basename.wav + basename.mid (mixed, shuffled)")
    parser.add_argument("--val", type=Path, nargs="+", help="Validation pair dirs (early stopping + gate)")
    parser.add_argument("--test", type=Path, nargs="*", default=[],
                        help="Extra held-out pair dirs, reported (stock vs tuned) but not used to select")
    parser.add_argument("--mic-gate", type=Path, default=None,
                        help="Real phone-mic gate: wav+mid pairs never trained on (>=30 clips to ship)")
    parser.add_argument("--epochs", type=int, default=8, help="(legacy, unused: see --max-epochs)")
    parser.add_argument("--lr", type=float, default=1e-4, help="peak learning rate")
    parser.add_argument("--warmup-steps", type=int, default=200)
    parser.add_argument("--batch", type=int, default=8)
    parser.add_argument("--windows-per-track", type=int, default=8,
                        help="Random AUDIO_N_SAMPLES windows sampled per track per pass")
    parser.add_argument("--steps-per-epoch", type=int, default=0,
                        help="Training steps per epoch (0 = one pass over the tracks)")
    parser.add_argument("--patience", type=int, default=4)
    parser.add_argument("--max-epochs", type=int, default=12)
    parser.add_argument("--onset-loss", choices=("plain", "weighted"), default="weighted",
                        help="weighted (default; class-balanced onset BCE as in the Basic Pitch "
                             "paper) or plain BCE (collapses the onset head, see EXPERIMENTS.md E2/E4)")
    parser.add_argument("--positive-weight", type=float, default=0.95, help="for --onset-loss weighted")
    parser.add_argument("--label-smoothing", type=float, default=0.2)
    parser.add_argument("--freeze-bn", action=argparse.BooleanOptionalAction, default=True)
    parser.add_argument("--augment", action=argparse.BooleanOptionalAction, default=True,
                        help="gain/EQ/reverb/noise augmentation of training windows")
    parser.add_argument("--tune-thresholds", action=argparse.BooleanOptionalAction, default=True,
                        help="grid-search onset/frame thresholds on --val for both models")
    parser.add_argument("--seed", type=int, default=1234)
    # Internal / eval: evaluate a SavedModel dir on --val pairs, write F1 JSON to --out.
    parser.add_argument("--eval-only", action="store_true")
    parser.add_argument("--savedmodel", type=Path, default=None)
    parser.add_argument("--out", type=Path, default=None)
    parser.add_argument("--onset-threshold", type=float, default=DEFAULT_ONSET_T)
    parser.add_argument("--frame-threshold", type=float, default=DEFAULT_FRAME_T)
    parser.add_argument("--min-note-len", type=int, default=DEFAULT_MIN_NOTE_LEN)
    args = parser.parse_args()

    if args.eval_only:
        if args.tune_thresholds and "--tune-thresholds" not in sys.argv:
            args.tune_thresholds = False  # opt-in for eval-only
        return eval_only(args)

    if args.smoke or not args.pairs:
        return smoke()
    for d in list(args.pairs) + list(args.val or []) + list(args.test):
        if not d.is_dir():
            raise SystemExit(f"missing dir {d}")
    if not args.val:
        raise SystemExit("missing --val dir(s)")
    if args.mic_gate is not None and not args.mic_gate.is_dir():
        raise SystemExit(f"missing --mic-gate dir {args.mic_gate}")
    # Resolve user paths before moving to the repo root.
    args.pairs = [d.resolve() for d in args.pairs]
    args.val = [d.resolve() for d in args.val]
    args.test = [d.resolve() for d in args.test]
    if args.mic_gate is not None:
        args.mic_gate = args.mic_gate.resolve()
    os.chdir(ROOT)
    if smoke() != 0:
        return 1

    import tensorflow as tf
    from basic_pitch import ICASSP_2022_MODEL_PATH, inference, models

    random.seed(args.seed)
    tf.random.set_seed(args.seed)
    t_start = time.time()
    train_pairs = read_many(args.pairs)
    val_pairs = read_many(args.val)
    if not train_pairs:
        raise SystemExit(f"no wav+mid pairs in {args.pairs}")
    if not val_pairs:
        raise SystemExit(f"no wav+mid pairs in {args.val}")
    mic_pairs = list(read_pairs(args.mic_gate)) if args.mic_gate else []
    test_sets = {d.name: list(read_pairs(d)) for d in args.test}
    log(f"pairs: train={len(train_pairs)} val={len(val_pairs)} mic_gate={len(mic_pairs)} "
        f"tests={ {k: len(v) for k, v in test_sets.items()} }")

    stamp = BUILD / str(int(time.time()))
    stamp.mkdir(parents=True, exist_ok=True)
    train_tfr = stamp / "train.tfrecord"
    val_tfr = stamp / "val.tfrecord"
    log("serializing TFRecords (22050 Hz mono)...")
    random.shuffle(train_pairs)  # mix sources so shuffle buffers see all of them
    train_stems = serialize_split(train_pairs, train_tfr)
    val_stems = serialize_split(val_pairs, val_tfr)
    (stamp / "pairs.json").write_text(json.dumps(
        {"train": train_stems, "val": val_stems,
         "mic_gate": [s for s, _, _ in mic_pairs]}, indent=2))
    if not train_stems or not val_stems:
        raise SystemExit("no usable pairs after serialization")
    (stamp / "args.json").write_text(json.dumps(
        {k: (str(v) if isinstance(v, Path) else [str(x) for x in v] if isinstance(v, list) else v)
         for k, v in vars(args).items()}, indent=2))

    log("building datasets...")
    train_ds = make_dataset(train_tfr, args.windows_per_track, args.batch, training=True,
                            augment=args.augment)
    val_ds = make_dataset(val_tfr, max(1, args.windows_per_track // 2), args.batch, training=False)
    steps = args.steps_per_epoch or max(1, len(train_stems) * args.windows_per_track // args.batch)

    log("loading ICASSP 2022 weights into models.model()...")
    model = models.model(no_contours=False)
    model = load_pretrained(model)
    if args.freeze_bn:
        freeze_batchnorm(model)

    # Stock baseline on val: early stopping must beat it to keep any fine-tuned weights.
    log("stock baseline on val (mir_eval, 50 ms onset tolerance)...")
    frozen = inference.Model(str(ICASSP_2022_MODEL_PATH))
    frozen_val_out = model_outputs(frozen, val_pairs)
    frozen_val = score_outputs(frozen_val_out, val_pairs, DEFAULT_ONSET_T, DEFAULT_FRAME_T)
    log(f"  stock val note F1 {frozen_val['mean_f1']:.4f} P {frozen_val['mean_precision']:.3f} "
        f"R {frozen_val['mean_recall']:.3f}")

    loss = models.loss(label_smoothing=args.label_smoothing,
                       weighted=args.onset_loss == "weighted",
                       positive_weight=args.positive_weight)
    total_steps = steps * args.max_epochs
    model.compile(optimizer=tf.keras.optimizers.Adam(
        WarmupCosine(args.lr, args.warmup_steps, total_steps)), loss=loss)
    best_dir = stamp / "model.best"
    best_weights = stamp / "best_weights.h5"  # .h5: a single file, so exists() is truthful
    eval_json = stamp / "val_f1.json"
    stopper = NoteF1EarlyStopping(model, args.val, best_weights, eval_json,
                                  patience=args.patience, baseline=frozen_val["mean_f1"])
    log(f"training: up to {args.max_epochs} epochs x {steps} steps, peak lr {args.lr} "
        f"(warmup {args.warmup_steps}, cosine), onset loss {args.onset_loss}, "
        f"freeze_bn={args.freeze_bn}, augment={args.augment}; early stop on val note-F1 "
        f"(patience {args.patience}, must beat stock {frozen_val['mean_f1']:.4f})")
    for epoch in range(args.max_epochs):
        model.fit(train_ds, validation_data=val_ds, epochs=epoch + 1, initial_epoch=epoch,
                  steps_per_epoch=steps, verbose=2)
        if stopper.on_epoch_end(epoch, best_dir):
            log(f"early stopping at epoch {stopper.stopped_epoch}")
            break
    train_minutes = round((time.time() - t_start) / 60, 1)
    if best_weights.exists():
        model.load_weights(str(best_weights))
        log(f"restored best-F1 weights from epoch {stopper.best_epoch} (val F1 {stopper.best:.4f})")
        improved = True
    else:
        log("no epoch beat stock on val; keeping stock weights")
        model = load_pretrained(model)
        improved = False
    model.save(str(best_dir))

    # ---- eval: fine-tuned vs frozen ICASSP checkpoint, val + tests + mic gate
    log("evaluating (mir_eval, 50 ms onset tolerance)...")
    tuned = inference.Model(str(best_dir))
    tuned_val_out = model_outputs(tuned, val_pairs)
    tuned_val = score_outputs(tuned_val_out, val_pairs, DEFAULT_ONSET_T, DEFAULT_FRAME_T)
    d = [DEFAULT_ONSET_T, DEFAULT_FRAME_T, DEFAULT_MIN_NOTE_LEN]
    thresholds = {"stock": d, "tuned": d}  # [onset, frame, min_note_len]
    if args.tune_thresholds:
        thresholds = {"stock": list(tune_thresholds(frozen_val_out, val_pairs)[:3]),
                      "tuned": list(tune_thresholds(tuned_val_out, val_pairs)[:3])}
        log(f"tuned decoder on val [onset, frame, min_note_len]: stock {thresholds['stock']}; "
            f"fine-tuned {thresholds['tuned']}")

    def both(pairs):
        if not pairs:
            return None
        fo, to_ = model_outputs(frozen, pairs), model_outputs(tuned, pairs)
        r = {"stock": summarize(score_outputs(fo, pairs, DEFAULT_ONSET_T, DEFAULT_FRAME_T)),
             "tuned": summarize(score_outputs(to_, pairs, DEFAULT_ONSET_T, DEFAULT_FRAME_T))}
        if args.tune_thresholds:
            r["stock@thr"] = summarize(score_outputs(fo, pairs, *thresholds["stock"]))
            r["tuned@thr"] = summarize(score_outputs(to_, pairs, *thresholds["tuned"]))
        return r

    tests = {name: both(p) for name, p in test_sets.items()}
    mic = both(mic_pairs)
    tuned_mic = mic["tuned"] if mic else None
    frozen_mic = mic["stock"] if mic else None

    ship = (
        improved
        and tuned_val["mean_f1"] >= frozen_val["mean_f1"]
        and tuned_mic is not None
        and tuned_mic["n_clips"] >= 30
        and tuned_mic["mean_f1"] >= frozen_mic["mean_f1"] - 0.02
    )
    metrics = {
        "stamp": stamp.name,
        "args": json.loads((stamp / "args.json").read_text()),
        "train_tracks": len(train_stems),
        "train_minutes": train_minutes,
        "best_epoch": stopper.best_epoch,
        "history": stopper.history,
        "synthetic_val": {"tuned": summarize(tuned_val), "frozen_icassp": summarize(frozen_val)},
        "thresholds": thresholds,
        "tests": tests,
        "real_mic_gate": mic,
        "ship_rule": {
            "beat_stock_during_training": improved,
            "synthetic_val_f1_at_least_stock": tuned_val["mean_f1"] >= frozen_val["mean_f1"],
            "mic_clips": tuned_mic["n_clips"] if tuned_mic else 0,
            "mic_f1_within_2pts": (
                tuned_mic["mean_f1"] >= frozen_mic["mean_f1"] - 0.02) if tuned_mic else False,
            "ship": ship,
        },
    }
    (stamp / "metrics.json").write_text(json.dumps(metrics, indent=2))
    (BUILD / "metrics.json").write_text(json.dumps(metrics, indent=2))
    log(f"metrics -> {stamp / 'metrics.json'}")
    log(f"val F1: tuned {tuned_val['mean_f1']:.4f} vs stock {frozen_val['mean_f1']:.4f}")
    for name, r in tests.items():
        if r:
            log(f"test {name}: tuned {r['tuned']['mean_f1']:.4f} vs stock {r['stock']['mean_f1']:.4f}")
    if tuned_mic:
        log(f"real-mic F1: tuned {tuned_mic['mean_f1']:.4f} vs stock {frozen_mic['mean_f1']:.4f} "
            f"({tuned_mic['n_clips']} clips)")
    else:
        log("real-mic gate: not provided (--mic-gate); cannot ship without it")

    if not ship:
        log("SHIP RULE FAILED (or mic gate missing): stock weights stay. models.lock untouched.")
        return 2

    if platform.system() != "Darwin":
        log(f"ship rule passed, but Core ML export needs macOS. Fine-tuned SavedModel: {best_dir}")
        log("Re-run the export on the Mac, or convert the SavedModel for the web demo "
            "(tools/web-demo/convert-model.sh).")
        return 0
    log("ship rule passed; exporting Core ML...")
    package = export_coreml(model, BUILD / PACKAGE_NAME, val_pairs, best_dir)
    r = subprocess.run(["scripts/bundle-coreml", str(package)], check=False)
    if r.returncode != 0:
        raise SystemExit("scripts/bundle-coreml failed")
    log("bundled. Run scripts/fetch-models (Xcode does this) to verify the pin.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
