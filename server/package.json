{
  "name": "music-radar-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI Music Radar API: StoreKit 2 verification, ASSN v2 webhook, devices, push, telemetry, admin",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrateCli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
